// jqfmt.nv — the renderers, and the CSV-to-JSON typing rule that makes
// a spreadsheet queryable.
//
// WHY THE RENDERERS ARE IN THE PACKAGE AT ALL.  A query language and a
// way to print its answers look like two concerns, and for JSON output
// they are — `json.stringify` is the standard library's.  Two of these
// are not:
//
//   * `cell_value` is a TYPING RULE, and it changes what queries mean.
//     A CSV cell has no type, so `select(.units > 100)` over a column
//     read as strings compares a string with a number and, under jq's
//     total order, matches every row.  The rule that avoids it belongs
//     beside the comparison it feeds, not in a caller;
//   * `columns` is the column arithmetic a tabular view needs, and it
//     is the one place the document ORDER of an object's members is
//     load-bearing — columns are every key any record carries, in the
//     order first seen, which is why `keys_unsorted` exists beside
//     `keys` in the builtin table.
//
// The rest are here because the alternative is `orbit/nq` keeping a
// `table.nv` that three other tools would each rewrite.  With these,
// nq's CLI is argv, files, stdout and exit codes: one file.
//
// A LIBRARY DOES NOT PRINT.  Every call here answers text.  `pretty`
// takes an indent rather than consulting a terminal, `tabular` takes a
// value rather than a file handle, and nothing in the module has an
// effect row — which is what keeps the package `core` and lets one
// rendering go to a screen, a file and a test.

use std.csv
use std.json
use std.list
use std.str

// ── Cells ────────────────────────────────────────────────────────────

// A row's cell by position, or the empty cell for a row that stops
// short — which the typing rule turns into `null`.
fn cell_at(row: [Str], i: Int) -> Str []
    if i < list.len(row)
        return row[i]
    ""

// One record of a headerless file: its cells typed, addressed by
// position.
fn typed_row(row: [Str]) -> JsonValueH []
    var out: [JsonValueH] = []
    for cell in row
        list.push(out, cell_value(cell))
    json.array(out)

// One record of a file with a header: keyed by the header names, with
// `null` for a cell the record does not carry and no key for a cell no
// name covers.
fn named_row(names: [Str], row: [Str]) -> JsonValueH []
    var out: [(Str, JsonValueH)] = []
    var i = 0
    for name in names
        list.push(out, (name, cell_value(cell_at(row, i))))
        i = i + 1
    json.object(out)

// ── Shapes ───────────────────────────────────────────────────────────

// What an element is for the purpose of sharing a shape with its
// siblings: a row when it is an object, a column when it is a scalar,
// and neither when it is an array.
fn element_class(v: JsonValueH) -> Str []
    let t = json.type_of(v)
    if t == "object"
        return "object"
    if t == "array"
        return "array"
    "scalar"

// Which table shape an array's elements share, or ragged when they do
// not share one.
fn classify(items: [JsonValueH]) -> JqShape []
    let first = element_class(items[0])
    if first == "array"
        return JqShapeRagged
    var same = true
    for item in items
        if element_class(item) != first
            same = false
    if not same
        return JqShapeRagged
    if first == "object"
        return JqShapeRows
    JqShapeColumn

// A type name as a plural, for the sentence that refuses an array of
// scalars.
fn plural(kind: Str) -> Str []
    match kind
        "number"  => "numbers"
        "string"  => "strings"
        "boolean" => "booleans"
        _         => "nulls"

// What an array of scalars holds, called by its type when they agree
// and `scalars` when they do not.
fn element_word(items: [JsonValueH]) -> Str []
    let first = json.type_of(items[0])
    var same = true
    for item in items
        if json.type_of(item) != first
            same = false
    if same
        return plural(first)
    "scalars"

// A type name with its article, for the sentence that refuses a scalar.
fn article_for(kind: Str) -> Str []
    if kind == "null"
        return "null"
    "a " + kind

// Why an array of scalars is not a table.
fn column_problem(items: [JsonValueH]) -> Str []
    "an array of " + element_word(items) + " has no columns — pipe it through `map({value: .})`"

// Why a scalar is not a table.
fn scalar_problem(v: JsonValueH) -> Str []
    article_for(json.type_of(v)) + " is not a table — wrap it in an object for one row, or an array of objects for many"

// Why an array whose elements do not share a shape is not a table.
fn ragged_problem() -> Str []
    "a ragged array is not a table — a table is an array of objects, and these elements are not all the same shape"

// ── Tables ───────────────────────────────────────────────────────────

// The rows a tabulatable value holds, in order.
fn grid_rows(v: JsonValueH) -> [JsonValueH] []
    match shape(v)
        JqShapeRow   => [v]
        JqShapeEmpty => []
        _            => json.to_list(v) ?? []

// One row of the grid: every column's cell text, `null` for a column
// the record does not carry.
fn row_cells(names: [Str], row: JsonValueH) -> [Str] []
    var out: [Str] = []
    for name in names
        list.push(out, cell_text(json.get(row, name) ?? json.null()))
    out

// The column names, then one row of cell text each.  The header row is
// always present, so a table with no columns is one empty row.
fn text_grid(v: JsonValueH) -> [[Str]] []
    let rows = grid_rows(v)
    var names = columns(rows)
    var out: [[Str]] = []
    list.push(out, names)
    for row in rows
        list.push(out, row_cells(names, row))
    out

// A cell's width in codepoints, which is what the alignment is by.
fn width_of(cell: Str) -> Int []
    list.len(str.chars(cell))

// A cell padded with spaces on the right to a width in codepoints.
fn pad_to(cell: Str, width: Int) -> Str []
    let gap = width - width_of(cell)
    if gap <= 0
        return cell
    cell + str.repeat(" ", gap)

// The widest cell in each column.  A grid is rectangular by
// construction, so the header's length is the column count.
fn column_widths(g: [[Str]]) -> [Int] []
    var widths: [Int] = []
    for c in 0..list.len(g[0])
        var w = 0
        for row in g
            let x = width_of(row[c])
            if x > w
                w = x
        list.push(widths, w)
    widths

// One line: every column padded but the last, one space between.
fn row_line(row: [Str], widths: [Int]) -> Str []
    var parts: [Str] = []
    var i = 0
    for cell in row
        if i + 1 < list.len(row)
            list.push(parts, pad_to(cell, widths[i]))
        else
            list.push(parts, cell)
        i = i + 1
    str.join(parts, " ")

// The grid as lines.
fn render_grid(g: [[Str]]) -> Str []
    let widths = column_widths(g)
    var lines: [Str] = []
    for row in g
        list.push(lines, row_line(row, widths))
    str.join(lines, "\n")

// Whether a field needs quotes under RFC 4180 § 2.6/2.7: a comma, a
// quote, a CR or a LF.
fn needs_quotes(text: Str) -> Bool []
    if str.contains(text, ",")
        return true
    if str.contains(text, "\"")
        return true
    if str.contains(text, "\n")
        return true
    str.contains(text, "\r")

// One cell as a CSV field.
//
// Hand-written rather than `csv.stringify`, which on this toolchain
// leaks one heap `Str` per input cell: every `novo test` run of this
// suite would print every verdict green and `the run leaked`, exit 23.
// `csv.parse` reads this writer's output back.
fn csv_field(cell: Str) -> Str []
    if not needs_quotes(cell)
        return cell
    "\"" + str.replace_all(cell, "\"", "\"\"") + "\""

// The grid as CSV records, one per line.
fn render_csv(g: [[Str]]) -> Str []
    var lines: [Str] = []
    for row in g
        var fields: [Str] = []
        for cell in row
            list.push(fields, csv_field(cell))
        list.push(lines, str.join(fields, ","))
    str.join(lines, "\n")

// ── Renderings ───────────────────────────────────────────────────────

// An array's members on their own lines.
fn render_array(items: [JsonValueH], level: Int, indent: Int) -> Str []
    if list.len(items) == 0
        return "[]"
    let inner = pad_to("", indent * (level + 1))
    var parts: [Str] = []
    for item in items
        list.push(parts, render_pretty(item, level + 1, indent))
    "[\n" + inner + str.join(parts, ",\n" + inner) + "\n" + pad_to("", indent * level) + "]"

// An object's members on their own lines, in document order.
fn render_object(names: [Str], v: JsonValueH, level: Int, indent: Int) -> Str []
    if list.len(names) == 0
        return "{}"
    let inner = pad_to("", indent * (level + 1))
    var parts: [Str] = []
    for name in names
        list.push(parts,
            json.stringify(json.string(name)) + ": " + render_pretty(json.get(v, name) ?? json.null(), level + 1, indent))
    "{\n" + inner + str.join(parts, ",\n" + inner) + "\n" + pad_to("", indent * level) + "}"

// One value, indented by `indent` spaces per level, sitting at `level`.
fn render_pretty(v: JsonValueH, level: Int, indent: Int) -> Str []
    let t = json.type_of(v)
    if t == "array"
        return render_array(json.to_list(v) ?? [], level, indent)
    if t == "object"
        return render_object(json.keys(v), v, level, indent)
    json.stringify(v)

// What shape a value has, for the purpose of drawing it as a table.
//
// A table needs rows and columns, and only two JSON shapes have them:
// an array of objects (rows are elements, columns are keys) and a
// single object (one row).  Everything else has to be refused with a
// reason, which is what `table_problem` is for.
pub enum JqShape
    // An array of objects: rows are its elements.
    JqShapeRows
    // One object: one row.
    JqShapeRow
    // An array of scalars: one column, no header.
    JqShapeColumn
    // A scalar.  Not a table.
    JqShapeScalar
    // An empty array.  A table with no rows, which is different from
    // not a table.
    JqShapeEmpty
    // An array whose elements are not all the same shape.  Not a
    // table, and the one a user most often has by accident.
    JqShapeRagged

// The type a CSV cell gets: the NARROWEST one whose rendering is
// byte-identical to the cell's own text.
//
// The round-trip condition is the whole rule, and it is what keeps a
// zip code intact: `00417` is a string because `417` does not render
// back as `00417`, and `1.50` is a string because `1.5` does not
// render back as `1.50`.  `120` is a number because it does.  An empty
// cell is `null`.
//
// Without any inference a numeric comparison over a CSV column
// compares strings and matches everything; with naive inference an
// identifier column loses its leading zeros.  The round trip is the
// line between the two, and it is checkable rather than a heuristic —
// `round_trips` is the same rule as a predicate.
//
// ```novo
// use std.json
// use jqfmt
//
// fn main() [io]
//     println(json.stringify(jqfmt.cell_value("00417")))
// ```
pub fn cell_value(text: Str) -> JsonValueH []
    if text == ""
        return json.null()
    match json.parse(text)
        None    => json.string(text)
        Some(v) =>
            if round_trips(text, v)
                return v
            json.string(text)

// Whether a value renders back as exactly this text.
//
// The condition `cell_value` decides by, published so the rule can be
// asserted directly rather than inferred from a table of examples.
//
// ```novo
// use std.json
// use jqfmt
//
// fn main() [io]
//     match json.parse("417")
//         None    => println("not json")
//         Some(v) => println("${jqfmt.round_trips("00417", v)}")
// ```
pub fn round_trips(text: Str, v: JsonValueH) -> Bool []
    match json.type_of(v)
        "number"  => json.stringify(v) == text
        "boolean" => json.stringify(v) == text
        "string"  => (json.to_str(v) ?? "") == text
        "null"    => text == ""
        _         => false

// Read CSV text as a JSON value.
//
// With a header row, each record becomes an object keyed by the header
// names; without one, each record becomes an array so `.[0]` is the
// first column.  Inventing names like `col1` for a headerless file
// would put names in the query that appear in no file anybody has.
//
// `None` when the text is not CSV at all.  A malformed record is the
// caller's exit code to choose, which is why this answers an optional
// rather than raising: the decision "stop, and say which line" belongs
// to whatever is reading the file.
//
// ```novo
// use std.json
// use jqfmt
//
// fn main() [io]
//     match jqfmt.csv_to_json("a,b\n1,2\n", true)
//         None    => println("not csv")
//         Some(v) => println(json.stringify(v))
// ```
pub fn csv_to_json(text: Str, has_header: Bool) -> ?JsonValueH []
    let rows = csv.parse(text)
    if list.len(rows) == 0
        return None
    if has_header
        let header = rows[0]
        let records = list.drop(rows, 1)
        var objects: [JsonValueH] = []
        for row in records
            list.push(objects, named_row(header, row))
        return Some(json.array(objects))
    var arrays: [JsonValueH] = []
    for row in rows
        list.push(arrays, typed_row(row))
    Some(json.array(arrays))

// What shape a value has.
//
// ```novo
// use std.json
// use jqfmt
//
// fn main() [io]
//     match json.parse("[]")
//         None    => println("not json")
//         Some(v) =>
//             match jqfmt.shape(v)
//                 JqShapeEmpty => println("a table with no rows")
//                 _            => println("something else")
// ```
pub fn shape(v: JsonValueH) -> JqShape []
    let t = json.type_of(v)
    if t == "object"
        return JqShapeRow
    if t != "array"
        return JqShapeScalar
    let items = json.to_list(v) ?? []
    if list.len(items) == 0
        return JqShapeEmpty
    classify(items)

// The column names of a set of rows: every key any record carries, in
// the order first seen.
//
// First seen rather than sorted, because a CSV read back out should
// come out in the order it went in, and because the first record's
// order is the one a person recognises.  A record missing a column
// gets `null` rather than a blank, so an absent field and an empty
// string stay distinguishable in the output.
//
// ```novo
// use std.json
// use jqfmt
//
// fn main() [io]
//     match json.parse("{\"a\":1}")
//         None    => println("not json")
//         Some(v) => println("${jqfmt.columns([v])}")
// ```
pub fn columns(rows: [JsonValueH]) -> [Str] []
    var out: [Str] = []
    for row in rows
        if json.type_of(row) == "object"
            for name in json.keys(row)
                if not list.contains(out, name)
                    list.push(out, name)
    out

// One cell's text: a string bare, and every other value as its JSON.
//
// A cell holding an array or an object shows that value's JSON rather
// than a blank.  Honest rather than pretty — flatten first if you want
// it pretty — and it means every cell in a column is something a
// reader can copy back into a query.
//
// ```novo
// use std.json
// use jqfmt
//
// fn main() [io]
//     match json.parse("[1,2]")
//         None    => println("not json")
//         Some(v) => println(jqfmt.cell_text(v))
// ```
pub fn cell_text(v: JsonValueH) -> Str []
    if json.type_of(v) == "string"
        return json.to_str(v) ?? ""
    json.stringify(v)

// The table as rows of cell text, header first, or `None` when the
// value has no table shape.
//
// The step below `tabular`, published because a caller drawing its own
// table — with box characters, with colour, into a terminal widget —
// wants the cells and not a rendering.  `table-nv` is that caller, and
// the width arithmetic is its business rather than this package's.
//
// ```novo
// use std.json
// use jqfmt
//
// fn main() [io]
//     match json.parse("[{\"a\":1}]")
//         None    => println("not json")
//         Some(v) =>
//             match jqfmt.grid(v)
//                 None    => println("not a table")
//                 Some(g) => println("${g}")
// ```
pub fn grid(v: JsonValueH) -> ?[[Str]] []
    match shape(v)
        JqShapeRows   => Some(text_grid(v))
        JqShapeRow    => Some(text_grid(v))
        JqShapeEmpty  => Some(text_grid(v))
        JqShapeColumn => None
        JqShapeScalar => None
        JqShapeRagged => None

// Why this value cannot be drawn as a table, or `None` when it can.
//
// A sentence naming the shape that was found, because "cannot tabulate
// that" sends a user looking at their data and "an array of numbers
// has no columns — pipe it through `map({value: .})`" sends them to the
// fix.
//
// ```novo
// use std.json
// use jqfmt
//
// fn main() [io]
//     match json.parse("3")
//         None    => println("not json")
//         Some(v) =>
//             match jqfmt.table_problem(v)
//                 None    => println("tabulates")
//                 Some(m) => println(m)
// ```
pub fn table_problem(v: JsonValueH) -> ?Str []
    match shape(v)
        JqShapeRows   => None
        JqShapeRow    => None
        JqShapeEmpty  => None
        JqShapeColumn => Some(column_problem(json.to_list(v) ?? []))
        JqShapeScalar => Some(scalar_problem(v))
        JqShapeRagged => Some(ragged_problem())

// The table as aligned columns, or `None` when the value has no table
// shape.
//
// Padded to the widest cell per column, one space between columns,
// header first.  The alignment is by CODEPOINTS: a cell's width in
// terminal cells is `table-nv`'s question, and answering it here would
// need a Unicode table this package has no business carrying.  A
// caller with CJK data wants `grid` and `table-nv`.
//
// ```novo
// use std.json
// use jqfmt
//
// fn main() [io]
//     match json.parse("[{\"a\":1}]")
//         None    => println("not json")
//         Some(v) =>
//             match jqfmt.tabular(v)
//                 None    => println("not a table")
//                 Some(t) => println(t)
// ```
pub fn tabular(v: JsonValueH) -> ?Str []
    match shape(v)
        JqShapeRows   => Some(render_grid(text_grid(v)))
        JqShapeRow    => Some(render_grid(text_grid(v)))
        JqShapeEmpty  => Some(render_grid(text_grid(v)))
        JqShapeColumn => None
        JqShapeScalar => None
        JqShapeRagged => None

// The table as CSV, or `None` when the value has no table shape.
//
// A column holding an array or an object gets that value's JSON,
// quoted by CSV's own rules — so the output is valid CSV and a nested
// value survives it as text rather than being dropped.
//
// ```novo
// use std.json
// use jqfmt
//
// fn main() [io]
//     match json.parse("[{\"a\":1}]")
//         None    => println("not json")
//         Some(v) =>
//             match jqfmt.csv_out(v)
//                 None    => println("not a table")
//                 Some(c) => println(c)
// ```
pub fn csv_out(v: JsonValueH) -> ?Str []
    match shape(v)
        JqShapeRows   => Some(render_csv(text_grid(v)))
        JqShapeRow    => Some(render_csv(text_grid(v)))
        JqShapeEmpty  => Some(render_csv(text_grid(v)))
        JqShapeColumn => None
        JqShapeScalar => None
        JqShapeRagged => None

// One value as one line of JSON.
//
// ```novo
// use std.json
// use jqfmt
//
// fn main() [io]
//     match json.parse("{\"a\":1}")
//         None    => println("not json")
//         Some(v) => println(jqfmt.compact(v))
// ```
pub fn compact(v: JsonValueH) -> Str []
    json.stringify(v)

// One value as indented JSON.
//
// The indent is an argument rather than a setting, so two renderings
// in one program cannot disagree about it.
//
// ```novo
// use std.json
// use jqfmt
//
// fn main() [io]
//     match json.parse("{\"a\":1}")
//         None    => println("not json")
//         Some(v) => println(jqfmt.pretty(v, 2))
// ```
pub fn pretty(v: JsonValueH, indent: Int) -> Str []
    render_pretty(v, 0, indent)

// One value with a string printed bare, and anything else as JSON.
//
// jq's `-r`, and the reason it is a rendering rather than a flag on
// the evaluator: it changes only what happens to a STRING, so
// `raw` over an object still gives JSON and the output of a query that
// selects paths is something to hand to another command.
//
// ```novo
// use std.json
// use jqfmt
//
// fn main() [io]
//     match json.parse("\"ada\"")
//         None    => println("not json")
//         Some(v) => println(jqfmt.raw(v))
// ```
pub fn raw(v: JsonValueH) -> Str []
    if json.type_of(v) == "string"
        return json.to_str(v) ?? ""
    compact(v)
