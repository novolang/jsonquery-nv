// jqbuiltin.nv — the builtin table, as data.
//
// THE TABLE IS A VALUE, NOT A `match` IN THE PARSER, and that is the
// whole argument for this module existing.  A parser that decides
// builtins with a branch can answer exactly one question — is this
// name one of mine — and four callers need a different one:
//
//   * an ERROR MESSAGE needs the arities a name does have, so
//     `range(1;2;3;4)` is told "range has 1, 2 and 3 arguments" rather
//     than "unknown function";
//   * COMPLETION in an editor needs the whole list with a summary
//     line each, and re-deriving it from a `match` means writing it
//     twice;
//   * the EVALUATOR needs to know which arguments are FILTERS rather
//     than values, because `map(.x)` runs its argument once per
//     element and `limit(3; f)` must not run its second argument at
//     all until it wants the next output;
//   * a REFUSAL needs a reason.  Six of jq's builtins are absent here
//     on purpose, and "unknown function gsub" is a worse answer than
//     the truth, which is that I-Regexp has no capture groups.
//
// `orbit/nq` is the case in point: its parser hard-codes six names and
// its error message hard-codes the same six in prose, a few hundred
// lines apart, and the two are one edit away from disagreeing.
//
// ONE VARIANT PER NAME AND ARITY.  jq overloads on argument count —
// `range/1`, `range/2` and `range/3` are three different filters — so
// the variant is the pair, not the name.  `resolve("range", 2)` is the
// lookup a parser does, and it cannot return the wrong one.
//
// WHAT IS NOT HERE, and why each absence is a decision rather than an
// oversight, is `absent_named` and `absence_reason`: the six regex
// builtins that need capture semantics, and the host builtins a `core`
// package has no machine to answer with.

use std.list
use std.str

// One builtin, named by what it is called and how many arguments it
// takes.  The groups below are jq's own manual's.
pub enum JqBuiltin
    // ── Control and streams ──────────────────────────────────────
    // `empty` — zero outputs.  The identity of `,`, and the filter
    // `select(false)` reduces to.
    JqbEmpty
    // `error` — raise the input as an error value.
    JqbError0
    // `error(v)` — raise `v`.
    JqbError1
    // `not` — the only jq builtin spelled as a filter rather than an
    // operator, because `!` is taken by `!=`.
    JqbNot
    // `recurse` — `.` and everything under it, depth first.
    JqbRecurse0
    // `recurse(f)` — `.`, then `f`, then `f` of that, until `f`
    // produces nothing.
    JqbRecurse1
    // `range(n)` — 0, 1, … n-1, as separate outputs.
    JqbRange1
    // `range(from; upto)`.
    JqbRange2
    // `range(from; upto; by)`.
    JqbRange3
    // `first(f)` — the first output of `f`, and `f` is not run again.
    // It is lazy: `f` is stopped after its first output, so a filter
    // with no end, or one longer than the run's ceilings, answers its
    // first output with no error.
    JqbFirst1
    // `last(f)`.
    JqbLast1
    // `limit(n; f)`: at most `n` outputs of `f`.  It is lazy: `f` is
    // stopped after `n` outputs, so `limit(1; recurse(.))` answers its
    // first output and does not run to a ceiling.  That is the reason
    // `takes_filter_argument` is published: an implementation that
    // collected `f` first would run an infinite `recurse(.)` forever.
    // The stop is not a budget, so it sets no error and leaves the
    // run's ceilings for the rest of the program.
    JqbLimit2
    // `until(cond; update)`.
    JqbUntil2
    // `while(cond; update)`.
    JqbWhile2

    // ── Types and their shape ────────────────────────────────────
    // `type` — "null", "boolean", "number", "string", "array",
    // "object".
    JqbType
    // `length` — elements, members, codepoints, or a number's absolute
    // value.  `null | length` is 0 and `true | length` is an error,
    // both of which are jq's and both of which `orbit/nq` asserts.
    JqbLength
    // `utf8bytelength` — a string's length in BYTES, which is the one
    // `length` is not.
    JqbUtf8ByteLength
    // `has(k)`.
    JqbHas1
    // `in(o)` — `has` with the arguments the other way round, so it
    // composes after a pipe.
    JqbIn1
    // `contains(v)`.
    JqbContains1
    // `inside(v)` — `contains` with the arguments the other way round.
    JqbInside1

    // ── Objects and arrays ───────────────────────────────────────
    // `keys` — an object's member names SORTED, or an array's indices.
    // The sort is jq's and is not RFC 9535's document order.
    JqbKeys
    // `keys_unsorted` — the same names in the order the document has
    // them.  Separate from `keys` because the standard library's JSON
    // value is what carries the order, and a caller round-tripping a
    // document wants this one.
    JqbKeysUnsorted
    // `values` — every value that is not `null`.
    JqbValues
    // `to_entries` — `{"a":1}` becomes `[{"key":"a","value":1}]`.
    JqbToEntries
    // `from_entries` — the inverse, accepting jq's four spellings of a
    // key (`key`, `k`, `name`, `Name`).
    JqbFromEntries
    // `with_entries(f)` — `to_entries | map(f) | from_entries`.
    JqbWithEntries1
    // `add` — the elements of an array added together, left to right.
    JqbAdd
    // `any` / `all` over an array of booleans.
    JqbAny0
    JqbAll0
    // `any(f)` / `all(f)` over the outputs of a filter.
    JqbAny1
    JqbAll1
    // `flatten` — all the way down.
    JqbFlatten0
    // `flatten(depth)`.
    JqbFlatten1

    // ── Selecting and mapping ────────────────────────────────────
    // `select(f)` — the input if `f` is truthy, and nothing otherwise.
    JqbSelect1
    // `map(f)` — `[.[] | f]`.
    JqbMap1
    // `map_values(f)` — the same, keeping an object's keys.
    JqbMapValues1
    // `path(f)` — the PATH `f` would select, as an array of names and
    // indices.  `jqlang.is_path_expression` is what decides whether a
    // filter may be the argument, and the refusal is at parse time.
    JqbPath1
    // `paths` — every path in the input, as arrays.
    JqbPaths0
    // `paths(f)` — the paths whose value satisfies `f`.
    JqbPaths1
    // `getpath(p)` — the value at a path array, `null` where there is
    // none.
    JqbGetpath1

    // ── Ordering ─────────────────────────────────────────────────
    // `sort` — by jq's total order, which is `jqeval.order`.
    JqbSort
    // `sort_by(f)` — by the OUTPUTS of `f` as an array, which is how
    // `sort_by(.a, .b)` sorts on two keys.
    JqbSortBy1
    // `group_by(f)` — sorted, then split where the key changes.
    JqbGroupBy1
    JqbUnique
    JqbUniqueBy1
    JqbReverse
    JqbMin
    JqbMax
    JqbMinBy1
    JqbMaxBy1

    // ── Strings ──────────────────────────────────────────────────
    // `tostring` — a string stays itself; everything else is its JSON.
    JqbToString
    JqbToNumber
    // `tojson` / `fromjson` — the pair that makes a JSON document
    // inside a string reachable.
    JqbToJson
    JqbFromJson
    JqbAsciiDowncase
    JqbAsciiUpcase
    // `explode` / `implode` — codepoints, not bytes.
    JqbExplode
    JqbImplode
    // `split(sep)` — on a literal separator.  jq's `split/2` is the
    // regex form and is absent with the rest of them.
    JqbSplit1
    JqbJoin1
    JqbLtrimstr1
    JqbRtrimstr1
    JqbStartswith1
    JqbEndswith1
    // `test(re)` — the one regex builtin, over I-Regexp.  `test/2`
    // takes jq's flags string, and flags are exactly what RFC 9485
    // removed, so it is refused by name.
    JqbTest1

    // ── Arithmetic ───────────────────────────────────────────────
    JqbFloor
    JqbCeil
    JqbSqrt

// Every builtin this package has, in the order the groups above are
// written.
//
// The list a completion, a documentation page and a `--list-builtins`
// flag all read, so none of them can drift from the parser.
//
// ```novo
// use std.list
// use jqbuiltin
//
// fn main() [io]
//     println("${list.len(jqbuiltin.all())}")
// ```
pub fn all() -> [JqBuiltin] []
    [JqbEmpty, JqbError0, JqbError1, JqbNot, JqbRecurse0, JqbRecurse1,
     JqbRange1, JqbRange2, JqbRange3, JqbFirst1, JqbLast1, JqbLimit2,
     JqbUntil2, JqbWhile2,
     JqbType, JqbLength, JqbUtf8ByteLength, JqbHas1, JqbIn1, JqbContains1,
     JqbInside1,
     JqbKeys, JqbKeysUnsorted, JqbValues, JqbToEntries, JqbFromEntries,
     JqbWithEntries1, JqbAdd, JqbAny0, JqbAll0, JqbAny1, JqbAll1,
     JqbFlatten0, JqbFlatten1,
     JqbSelect1, JqbMap1, JqbMapValues1, JqbPath1, JqbPaths0, JqbPaths1,
     JqbGetpath1,
     JqbSort, JqbSortBy1, JqbGroupBy1, JqbUnique, JqbUniqueBy1, JqbReverse,
     JqbMin, JqbMax, JqbMinBy1, JqbMaxBy1,
     JqbToString, JqbToNumber, JqbToJson, JqbFromJson, JqbAsciiDowncase,
     JqbAsciiUpcase, JqbExplode, JqbImplode, JqbSplit1, JqbJoin1,
     JqbLtrimstr1, JqbRtrimstr1, JqbStartswith1, JqbEndswith1, JqbTest1,
     JqbFloor, JqbCeil, JqbSqrt]

// What a builtin is called, without its arity.
//
// ```novo
// use jqbuiltin
//
// fn main() [io]
//     println(jqbuiltin.name(JqbRange2))
// ```
pub fn name(b: JqBuiltin) -> Str []
    match b
        JqbEmpty          => "empty"
        JqbError0         => "error"
        JqbError1         => "error"
        JqbNot            => "not"
        JqbRecurse0       => "recurse"
        JqbRecurse1       => "recurse"
        JqbRange1         => "range"
        JqbRange2         => "range"
        JqbRange3         => "range"
        JqbFirst1         => "first"
        JqbLast1          => "last"
        JqbLimit2         => "limit"
        JqbUntil2         => "until"
        JqbWhile2         => "while"
        JqbType           => "type"
        JqbLength         => "length"
        JqbUtf8ByteLength => "utf8bytelength"
        JqbHas1           => "has"
        JqbIn1            => "in"
        JqbContains1      => "contains"
        JqbInside1        => "inside"
        JqbKeys           => "keys"
        JqbKeysUnsorted   => "keys_unsorted"
        JqbValues         => "values"
        JqbToEntries      => "to_entries"
        JqbFromEntries    => "from_entries"
        JqbWithEntries1   => "with_entries"
        JqbAdd            => "add"
        JqbAny0           => "any"
        JqbAll0           => "all"
        JqbAny1           => "any"
        JqbAll1           => "all"
        JqbFlatten0       => "flatten"
        JqbFlatten1       => "flatten"
        JqbSelect1        => "select"
        JqbMap1           => "map"
        JqbMapValues1     => "map_values"
        JqbPath1          => "path"
        JqbPaths0         => "paths"
        JqbPaths1         => "paths"
        JqbGetpath1       => "getpath"
        JqbSort           => "sort"
        JqbSortBy1        => "sort_by"
        JqbGroupBy1       => "group_by"
        JqbUnique         => "unique"
        JqbUniqueBy1      => "unique_by"
        JqbReverse        => "reverse"
        JqbMin            => "min"
        JqbMax            => "max"
        JqbMinBy1         => "min_by"
        JqbMaxBy1         => "max_by"
        JqbToString       => "tostring"
        JqbToNumber       => "tonumber"
        JqbToJson         => "tojson"
        JqbFromJson       => "fromjson"
        JqbAsciiDowncase  => "ascii_downcase"
        JqbAsciiUpcase    => "ascii_upcase"
        JqbExplode        => "explode"
        JqbImplode        => "implode"
        JqbSplit1         => "split"
        JqbJoin1          => "join"
        JqbLtrimstr1      => "ltrimstr"
        JqbRtrimstr1      => "rtrimstr"
        JqbStartswith1    => "startswith"
        JqbEndswith1      => "endswith"
        JqbTest1          => "test"
        JqbFloor          => "floor"
        JqbCeil           => "ceil"
        JqbSqrt           => "sqrt"

// How many arguments it takes.
//
// ```novo
// use jqbuiltin
//
// fn main() [io]
//     println("${jqbuiltin.arity(JqbRange2)}")
// ```
pub fn arity(b: JqBuiltin) -> Int []
    match b
        JqbEmpty          => 0
        JqbError0         => 0
        JqbError1         => 1
        JqbNot            => 0
        JqbRecurse0       => 0
        JqbRecurse1       => 1
        JqbRange1         => 1
        JqbRange2         => 2
        JqbRange3         => 3
        JqbFirst1         => 1
        JqbLast1          => 1
        JqbLimit2         => 2
        JqbUntil2         => 2
        JqbWhile2         => 2
        JqbType           => 0
        JqbLength         => 0
        JqbUtf8ByteLength => 0
        JqbHas1           => 1
        JqbIn1            => 1
        JqbContains1      => 1
        JqbInside1        => 1
        JqbKeys           => 0
        JqbKeysUnsorted   => 0
        JqbValues         => 0
        JqbToEntries      => 0
        JqbFromEntries    => 0
        JqbWithEntries1   => 1
        JqbAdd            => 0
        JqbAny0           => 0
        JqbAll0           => 0
        JqbAny1           => 1
        JqbAll1           => 1
        JqbFlatten0       => 0
        JqbFlatten1       => 1
        JqbSelect1        => 1
        JqbMap1           => 1
        JqbMapValues1     => 1
        JqbPath1          => 1
        JqbPaths0         => 0
        JqbPaths1         => 1
        JqbGetpath1       => 1
        JqbSort           => 0
        JqbSortBy1        => 1
        JqbGroupBy1       => 1
        JqbUnique         => 0
        JqbUniqueBy1      => 1
        JqbReverse        => 0
        JqbMin            => 0
        JqbMax            => 0
        JqbMinBy1         => 1
        JqbMaxBy1         => 1
        JqbToString       => 0
        JqbToNumber       => 0
        JqbToJson         => 0
        JqbFromJson       => 0
        JqbAsciiDowncase  => 0
        JqbAsciiUpcase    => 0
        JqbExplode        => 0
        JqbImplode        => 0
        JqbSplit1         => 1
        JqbJoin1          => 1
        JqbLtrimstr1      => 1
        JqbRtrimstr1      => 1
        JqbStartswith1    => 1
        JqbEndswith1      => 1
        JqbTest1          => 1
        JqbFloor          => 0
        JqbCeil           => 0
        JqbSqrt           => 0

// jq's own spelling of the pair: `range/2`.
//
// ```novo
// use jqbuiltin
//
// fn main() [io]
//     println(jqbuiltin.signature(JqbRange2))
// ```
pub fn signature(b: JqBuiltin) -> Str []
    name(b) + "/" + str.from_int(arity(b))

// One line describing what it does, for a completion list or an error.
//
// ```novo
// use jqbuiltin
//
// fn main() [io]
//     println(jqbuiltin.summary(JqbKeys))
// ```
pub fn summary(b: JqBuiltin) -> Str []
    match b
        JqbEmpty          => "empty: no outputs at all"
        JqbError0         => "error: raise the input as an error value"
        JqbError1         => "error(v): raise v as an error value"
        JqbNot            => "not: true when the input is false or null"
        JqbRecurse0       => "recurse: the input and everything under it, depth first"
        JqbRecurse1       => "recurse(f): the input, then f of it, until f is empty"
        JqbRange1         => "range(n): 0 to n-1, one output each"
        JqbRange2         => "range(from; upto): from to upto-1, one output each"
        JqbRange3         => "range(from; upto; by): from to upto-1 stepping by by"
        JqbFirst1         => "first(f): the first output of f, and f stops there (lazy)"
        JqbLast1          => "last(f): the last output of f"
        JqbLimit2         => "limit(n; f): at most n outputs of f, and f stops there (lazy)"
        JqbUntil2         => "until(cond; update): update until cond is true"
        JqbWhile2         => "while(cond; update): the input while cond is true"
        JqbType           => "type: the input's JSON type name"
        JqbLength         => "length: members, elements, codepoints, or a number's absolute value"
        JqbUtf8ByteLength => "utf8bytelength: a string's length in bytes"
        JqbHas1           => "has(k): whether the input has the key or index k"
        JqbIn1            => "in(o): whether o has the input as a key or index"
        JqbContains1      => "contains(v): whether the input contains v"
        JqbInside1        => "inside(v): whether v contains the input"
        JqbKeys           => "keys: an object's member names sorted, or an array's indices"
        JqbKeysUnsorted   => "keys_unsorted: the member names in document order"
        JqbValues         => "values: the input unless it is null"
        JqbToEntries      => "to_entries: an object as a list of key and value pairs"
        JqbFromEntries    => "from_entries: a list of key and value pairs as an object"
        JqbWithEntries1   => "with_entries(f): to_entries, map(f), from_entries"
        JqbAdd            => "add: the elements of an array added together, left to right"
        JqbAny0           => "any: whether any element of an array of booleans is true"
        JqbAll0           => "all: whether every element of an array of booleans is true"
        JqbAny1           => "any(f): whether f is true for any output"
        JqbAll1           => "all(f): whether f is true for every output"
        JqbFlatten0       => "flatten: the nested arrays, all the way down"
        JqbFlatten1       => "flatten(depth): the nested arrays to depth levels"
        JqbSelect1        => "select(f): the input when f is truthy, nothing otherwise"
        JqbMap1           => "map(f): f applied to every element, as an array"
        JqbMapValues1     => "map_values(f): f applied to every element, keeping keys"
        JqbPath1          => "path(f): the path f selects, as an array of names and indices"
        JqbPaths0         => "paths: every path in the input, as arrays"
        JqbPaths1         => "paths(f): the paths whose value satisfies f"
        JqbGetpath1       => "getpath(p): the value at a path array, null where there is none"
        JqbSort           => "sort: the elements in jq's total order"
        JqbSortBy1        => "sort_by(f): the elements in the order of f's outputs"
        JqbGroupBy1       => "group_by(f): the elements sorted and split where the key changes"
        JqbUnique         => "unique: the sorted elements with duplicates removed"
        JqbUniqueBy1      => "unique_by(f): the elements with duplicate keys removed"
        JqbReverse        => "reverse: the elements in the opposite order"
        JqbMin            => "min: the smallest element by jq's total order"
        JqbMax            => "max: the largest element by jq's total order"
        JqbMinBy1         => "min_by(f): the element whose f output is smallest"
        JqbMaxBy1         => "max_by(f): the element whose f output is largest"
        JqbToString       => "tostring: a string as itself, anything else as its JSON"
        JqbToNumber       => "tonumber: a number as itself, a numeric string as the number, and any other string refused"
        JqbToJson         => "tojson: the input as a JSON string"
        JqbFromJson       => "fromjson: the JSON document inside a string"
        JqbAsciiDowncase  => "ascii_downcase: the ASCII letters lowered"
        JqbAsciiUpcase    => "ascii_upcase: the ASCII letters raised"
        JqbExplode        => "explode: a string as its codepoints"
        JqbImplode        => "implode: codepoints as a string"
        JqbSplit1         => "split(sep): a string split on a literal separator"
        JqbJoin1          => "join(sep): an array of strings joined by a separator"
        JqbLtrimstr1      => "ltrimstr(s): the input with one leading s removed; a side that is not a string leaves the input as it was"
        JqbRtrimstr1      => "rtrimstr(s): the input with one trailing s removed; a side that is not a string leaves the input as it was"
        JqbStartswith1    => "startswith(s): whether the input starts with s"
        JqbEndswith1      => "endswith(s): whether the input ends with s"
        JqbTest1          => "test(re): whether the input matches an I-Regexp pattern"
        JqbFloor          => "floor: the input rounded down"
        JqbCeil           => "ceil: the input rounded up"
        JqbSqrt           => "sqrt: the input's square root, `null` for an input below zero"

// The builtin a name and an argument count denote.
//
// The lookup the parser makes, and the reason the variant is the pair
// rather than the name: there is no way for this to answer `range/1`
// when the program wrote `range/2`.
//
// ```novo
// use jqbuiltin
//
// fn main() [io]
//     match jqbuiltin.resolve("range", 2)
//         None    => println("no such builtin")
//         Some(b) => println(jqbuiltin.signature(b))
// ```
pub fn resolve(name_text: Str, argument_count: Int) -> ?JqBuiltin []
    var found: ?JqBuiltin = None
    for b in all()
        if name(b) == name_text
            if arity(b) == argument_count
                found = Some(b)
    found

// Whether any builtin is called this, at any arity.
//
// What separates "there is no such function" from "there is, but not
// with that many arguments", which are two different things to be told.
//
// ```novo
// use jqbuiltin
//
// fn main() [io]
//     println("${jqbuiltin.is_known_name("range")}")
// ```
pub fn is_known_name(name_text: Str) -> Bool []
    var known = false
    for b in all()
        if name(b) == name_text
            known = true
    known

// The argument counts a name has forms for, ascending.
//
// The message a `JqWrongArity` fault is built from: `range` answers
// `[1, 2, 3]`, and `length` answers `[0]`.
//
// ```novo
// use jqbuiltin
//
// fn main() [io]
//     println("${jqbuiltin.arities_of("range")}")
// ```
pub fn arities_of(name_text: Str) -> [Int] []
    var out: [Int] = []
    for b in all()
        if name(b) == name_text
            if not list.contains(out, arity(b))
                list.push(out, arity(b))
    out = list.sort(out)
    out

// Whether argument `index` is a FILTER rather than a value.
//
// The fact an evaluator cannot work without and a table of names and
// arities does not carry.  `map(.x)` runs its argument once per
// element with the element as input; `ltrimstr("a")` evaluates its
// argument once against the same input and uses the value.  An
// implementation that guessed would either break `map` or run the `f`
// in `limit(3; recurse(.))` forever.
//
// ```novo
// use jqbuiltin
//
// fn main() [io]
//     println("${jqbuiltin.takes_filter_argument(JqbMap1, 0)}")
// ```
pub fn takes_filter_argument(b: JqBuiltin, index: Int) -> Bool []
    match b
        JqbRecurse1     => index == 0
        JqbFirst1       => index == 0
        JqbLast1        => index == 0
        JqbLimit2       => index == 1
        JqbUntil2       => index == 0 or index == 1
        JqbWhile2       => index == 0 or index == 1
        JqbWithEntries1 => index == 0
        JqbAny1         => index == 0
        JqbAll1         => index == 0
        JqbSelect1      => index == 0
        JqbMap1         => index == 0
        JqbMapValues1   => index == 0
        JqbPath1        => index == 0
        JqbPaths1       => index == 0
        JqbSortBy1      => index == 0
        JqbGroupBy1     => index == 0
        JqbUniqueBy1    => index == 0
        JqbMinBy1       => index == 0
        JqbMaxBy1       => index == 0
        _               => false

// Whether a builtin can produce more than one output for one input.
//
// `range`, `recurse`, `paths` and `empty` can; `length` cannot.  A
// caller sizing a buffer, or a linter warning that `[limit(1; f)]` is
// the same as `[first(f)]`, reads this rather than a list of names.
//
// ```novo
// use jqbuiltin
//
// fn main() [io]
//     println("${jqbuiltin.may_stream(JqbRange1)}")
// ```
pub fn may_stream(b: JqBuiltin) -> Bool []
    match b
        JqbEmpty    => true
        JqbRecurse0 => true
        JqbRecurse1 => true
        JqbRange1   => true
        JqbRange2   => true
        JqbRange3   => true
        JqbLimit2   => true
        JqbWhile2   => true
        JqbPath1    => true
        JqbPaths0   => true
        JqbPaths1   => true
        _           => false

// The jq builtins this package refuses BY NAME, with a reason each.
//
// Published as data because "unknown function" is the wrong answer for
// a name jq has: a user who wrote `gsub` did not misspell anything,
// and telling them so sends them looking for a typo.  Two groups:
//
//   * the regex family — `match`, `capture`, `scan`, `splits`, `sub`,
//     `gsub`, and `test/2` — which need capture groups and match
//     offsets.  I-Regexp (RFC 9485) has no capture semantics at all,
//     and `jpregex` answers a `Bool`; inventing offsets here would
//     mean inventing a pattern language beside the portable one, which
//     is the thing the choice of I-Regexp was made to avoid;
//   * the host family — `env`, `$ENV`, `input`, `inputs`,
//     `input_line_number`, `now`, `localtime`, `strftime`,
//     `halt_error`, `debug` — which read a machine.  A `core` package
//     has no environment, no clock and no standard input, and a jq
//     program that silently answered `null` for `env.HOME` would be
//     worse than one that refused.
//
// ```novo
// use std.list
// use jqbuiltin
//
// fn main() [io]
//     println("${list.len(jqbuiltin.absent_named())}")
// ```
pub fn absent_named() -> [Str] []
    ["match", "capture", "scan", "splits", "sub", "gsub", "test",
     "env", "\$ENV", "input", "inputs", "input_line_number", "now",
     "localtime", "strftime", "halt_error", "debug"]

// Why that name is absent, or `None` when it is not a jq builtin at
// all.
//
// ```novo
// use jqbuiltin
//
// fn main() [io]
//     match jqbuiltin.absence_reason("gsub")
//         None    => println("not a refusal")
//         Some(r) => println(r)
// ```
pub fn absence_reason(name_text: Str) -> ?Str []
    match name_text
        "match"             => Some("I-Regexp (RFC 9485) has no capture groups, so a filter that answers match objects cannot be built on it")
        "capture"           => Some("capture names captured groups, and I-Regexp (RFC 9485) has no capture groups")
        "scan"              => Some("scan answers every match with its capture groups, and I-Regexp (RFC 9485) has none")
        "splits"            => Some("splits is the regex form of split, and I-Regexp (RFC 9485) has no capture groups to split on")
        "sub"               => Some("sub replaces the text a regex matched and needs capture groups, neither of which I-Regexp (RFC 9485) carries")
        "gsub"              => Some("gsub replaces the text a regex matched and needs capture groups, neither of which I-Regexp (RFC 9485) carries")
        "test"              => Some("test/1 is here over I-Regexp; test/2 takes jq's flags string, and flags are what RFC 9485 removed")
        "env"               => Some("env reads the process environment, and this package is core: a host layer could answer it")
        "\$ENV"             => Some("\$ENV reads the process environment, and this package is core: a host layer could answer it")
        "input"             => Some("input reads standard input, and this package is core: a host layer could answer it")
        "inputs"            => Some("inputs reads standard input, and this package is core: a host layer could answer it")
        "input_line_number" => Some("input_line_number counts standard input's lines, and this package is core: a host layer could answer it")
        "now"               => Some("now reads the clock, and this package is core: a host layer could answer it")
        "localtime"         => Some("localtime reads the clock and the local offset, and this package is core: a host layer could answer it")
        "strftime"          => Some("strftime reads the clock and a time zone, and this package is core: a host layer could answer it")
        "halt_error"        => Some("halt_error stops the process, and this package is core: a host layer could answer it")
        "debug"             => Some("debug writes to jq's debug stream, and this package is core: a host layer could answer it")
        _                   => None

// Whether a name is one a HOST could supply.
//
// The split inside `absent_named`, as a predicate: `env` and `input`
// are absent because this package is `core`, so a `host` package built
// over it could answer them, and a caller reading the refusal should
// be told which side of that line the name falls on.  `gsub` is on the
// other side — no layer makes I-Regexp grow capture groups.
//
// ```novo
// use jqbuiltin
//
// fn main() [io]
//     println("${jqbuiltin.absent_for_layer("env")}")
// ```
pub fn absent_for_layer(name_text: Str) -> Bool []
    match name_text
        "env"               => true
        "\$ENV"             => true
        "input"             => true
        "inputs"            => true
        "input_line_number" => true
        "now"               => true
        "localtime"         => true
        "strftime"          => true
        "halt_error"        => true
        "debug"             => true
        _                   => false
